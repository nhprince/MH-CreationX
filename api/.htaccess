# Deny direct access to sensitive files
<Files ".env">
    Order allow,deny
    Deny from all
</Files>
<Files "*.php~">
    Order allow,deny
    Deny from all
</Files>
# CORS and security headers (already in PHP, but backup)
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Device-Fingerprint"
</IfModule>
# PHP settings
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300